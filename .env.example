# Config for the production stack (docker-compose.yml) — the platform
# itself (Postgres + api + web), deployed once on your own box (e.g. via
# Dokploy). Copy this to .env and fill in real values before deploying.
#
# docker-compose.dev.yml (local dev) hardcodes its throwaway DB
# credentials on purpose, so local dev works with zero setup for those.
# The dev web server (bun dev) reads its own web/.env.local instead.

# --- Postgres ---
POSTGRES_USER=swuser
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-18
POSTGRES_DB=security_whatnot

# --- Public URLs (must be real, reachable domains in production; the
# agent and browser both need to reach these over HTTPS) ---
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_WEB_URL=https://yourdomain.com

# --- Better Auth secret (signs session cookies) ---
# Generate with: openssl rand -base64 32
# (An existing AUTH_SECRET from the Auth.js days is still picked up.)
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- Report email rendering (worker -> web) ---
# The worker POSTs each report to web's internal render route and emails
# the result. Shared by both services; generate with: openssl rand -base64 32
SW_INTERNAL_RENDER_SECRET=change-me-generate-with-openssl-rand-base64-32
# Where the worker reaches web on the compose network. Defaults to
# http://web:3000; never the public URL (the route refuses that host).
# SW_WEB_INTERNAL_URL=http://web:3000

# --- Better Auth trusted origins ---
# Sign-in/sign-up requests are accepted from PUBLIC_WEB_URL's origin only.
# If the dashboard is also served on other origins, list them here,
# comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=https://other.yourdomain.com
