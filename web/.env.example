DATABASE_URL=postgres://swuser:swpass@localhost:5432/security_whatnot?sslmode=disable
NEXT_PUBLIC_API_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Auth.js won't trust a plain-http, non-fixed dev host by default.
AUTH_TRUST_HOST=true
# Dev only: accept http:// and private/loopback webhook URLs in the
# Notifications forms (the worker needs the same variable). Never in production.
# SW_NOTIFY_ALLOW_PRIVATE_NETWORKS=true
# Report emails: the worker POSTs snapshots to /api/internal/render/report.
# Off (404) while the secret is unset; only answered on the host of
# SW_WEB_INTERNAL_URL, the URL the worker uses (the dev worker runs in
# Docker, hence host.docker.internal). Set the same two values on the worker.
# SW_INTERNAL_RENDER_SECRET=generate-with-openssl-rand-base64-32
# SW_WEB_INTERNAL_URL=http://host.docker.internal:3000
