# Shell scripts must check out with LF regardless of the cloning machine's
# git config — CRLF line endings break bash on macOS/Linux (e.g. a CRLF
# shebang line, or `$'\r': command not found` from a stray \r on ARGV).
*.sh text eol=lf

# Generated by `go test ./internal/notify/notifiers -update` and compared
# byte-for-byte by TestSchemaFileIsCurrent, so it must stay LF on checkout.
web/src/lib/notifier-types.json text eol=lf
