# Config for deploy/docker-compose.yml. Copy to .env next to it and
# replace every value below.

# Image tag for upkeep-server and upkeep-web (defaults to the version the
# compose file was written for).
# UPKEEP_VERSION=0.1.2

# Postgres password. Hex only, because it's embedded in a database URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-24-output
# Optional:
# POSTGRES_USER=swuser
# POSTGRES_DB=security_whatnot

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output=

# Shared by worker and web for report-email rendering.
# Generate with: openssl rand -base64 32
SW_INTERNAL_RENDER_SECRET=replace-me-with-openssl-rand-base64-32-output=

# Public HTTPS URLs your reverse proxy serves. Browsers use the web URL;
# agents on your monitored hosts report to the API URL.
PUBLIC_WEB_URL=https://upkeep.example.com
PUBLIC_API_URL=https://api.upkeep.example.com

# Host ports the proxy forwards to (defaults 3000 and 8080).
# UPKEEP_WEB_PORT=3000
# UPKEEP_API_PORT=8080

# Other origins serving the dashboard, comma-separated (optional).
# BETTER_AUTH_TRUSTED_ORIGINS=https://other.example.com
